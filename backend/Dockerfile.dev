# syntax=docker/dockerfile:1
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /uvx /usr/local/bin/

# El venv vive FUERA de /app: el bind mount de ./backend:/app no debe destruir
# las dependencias instaladas en la imagen.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=0 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# libmagic: validación de tipo MIME real de los archivos subidos (A08).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libmagic1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Capa de dependencias cacheada: solo se reconstruye si cambian el manifiesto o el lock.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen

# Contenedor no root también en desarrollo (A05). El volumen de subidas se crea
# aquí con el ownership correcto: si no existiera en la imagen, Docker lo montaría
# como root:root y la primera escritura fallaría con PermissionError.
RUN groupadd -r app && useradd -r -g app app \
    && mkdir -p /srv/uploads \
    && chown -R app:app /srv/uploads /opt/venv

COPY --chown=app:app . .
USER app

EXPOSE 8000

# --proxy-headers también en desarrollo: sin él, la IP del AuditLog y la del rate
# limiting serían la del contenedor nginx en lugar de la del cliente real.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", \
     "--proxy-headers", "--forwarded-allow-ips=*"]
