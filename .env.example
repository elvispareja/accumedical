# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de configuración. Cópiala a .env y rellena los valores reales:
#     cp .env.example .env
# El .env está en .gitignore y NUNCA se versiona.
#
# Compose lee este archivo del host e inyecta las claves como variables de
# entorno en los contenedores; pydantic-settings las valida al arrancar y el
# proceso se niega a levantar si algo falta o es inválido.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_USER=accumedical
POSTGRES_PASSWORD=cambiame-en-tu-.env
POSTGRES_DB=accumedical
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Puerto en el HOST para conectar con psql/DBeaver (solo desarrollo).
# El 5432 suele estar ocupado por otro Postgres local.
POSTGRES_HOST_PORT=55432

# ── Entorno ──────────────────────────────────────────────────────────────────
# development | production. En production, DEBUG=True impide arrancar.
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Secretos ─────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=genera-uno-de-al-menos-32-caracteres-y-pegalo-aqui
# Clave Fernet para cifrar users.mfa_secret. Genera una con:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=genera-una-clave-fernet-y-pegala-aqui

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowlist explícita, sin comodines y SIN barra final.
ALLOWED_ORIGINS=["http://localhost:8080"]

# ── Cookies de sesión ────────────────────────────────────────────────────────
# En desarrollo va sin Secure porque el entorno local es http://localhost.
# En production, COOKIE_SECURE=false impide arrancar.
COOKIE_SECURE=false
# Prefijo del nombre de la cookie. En producción: __Host-
COOKIE_PREFIX=

# ── Sesión (A07) ─────────────────────────────────────────────────────────────
SESSION_IDLE_TTL_MIN=30
SESSION_ABSOLUTE_TTL_MIN=720
SESSION_ACTIVITY_THROTTLE_SEC=60
SESSION_PURGE_AFTER_DAYS=30

# ── Login y bloqueo de cuenta (A04) ──────────────────────────────────────────
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MIN=15
LOGIN_RATE_LIMIT_IP=5/minute

# ── Subida de archivos (A08) ─────────────────────────────────────────────────
# UPLOAD_MAX_SIZE_MB debe moverse junto con client_max_body_size de nginx.
UPLOAD_DIR=/srv/uploads
UPLOAD_MAX_SIZE_MB=5

# ── Bootstrap del administrador global ───────────────────────────────────────
# Solo los lee el comando `python -m app.cli create-superadmin`, que es
# idempotente. La contraseña real va únicamente en tu .env, jamás aquí.
SUPERADMIN_EMAIL=admin@accumedical.med.ec
SUPERADMIN_PASSWORD=pon-aqui-la-contrasena-en-tu-.env

# ── Solo desarrollo en Windows ───────────────────────────────────────────────
WATCHFILES_FORCE_POLLING=true
VITE_HMR_CLIENT_PORT=8080

# ── Correo de invitaciones ───────────────────────────────────────────────────
# Sin SMTP_HOST no se envía nada: en desarrollo el mensaje se registra en el log
# del contenedor `api` con su enlace, y en producción el arranque falla.
# El cifrado (STARTTLS en el 587, o SSL directo en el 465) es OBLIGATORIO en
# producción; en desarrollo se permite en claro para poder usar un capturador
# local de correo como MailHog o Mailpit.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=
MAIL_FROM_NOMBRE=Accumedical
# Base pública desde la que se arma el enlace de la invitación. Nunca se deduce
# de la cabecera Host: sería suplantable. En producción, https obligatorio.
APP_BASE_URL=http://localhost:8080
INVITACION_TTL_HORAS=72

# ── IA: el informe del auditor (app móvil) ───────────────────────────────────
# La clave de la API de Anthropic. Sin ella, el resto del panel funciona y el
# botón de redactar responde 503 con un mensaje claro. La clave real va SOLO en
# tu .env; el único destino posible está fijo en código (api.anthropic.com).
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_TIMEOUT_SEC=240

# El dictado por voz se transcribe LOCALMENTE con Whisper (faster-whisper, CPU):
# el audio clínico no sale del servidor. El modelo se descarga una única vez al
# volumen de subidas. tiny | base | small | medium — small equilibra bien en español.
STT_MODELO=small

# ── Membrete de los correos ──────────────────────────────────────────────────
# Quién firma al pie de los avisos e informes por correo (el logo va incrustado
# en el mensaje). Opcionales: por defecto firma la gerente general.
# MAIL_FIRMA_NOMBRE=Dra. Milady Inés Pareja Paredes
# MAIL_FIRMA_CARGO=Gerente General · Perito Médico
# MAIL_FIRMA_CORREO=peritomedico@accumedical.med.ec
# MAIL_FIRMA_WEB=www.accumedical.med.ec

# ── Firma electrónica de los informes (PAdES) ────────────────────────────────
# El .p12 de la empresa (Registro Civil, Security Data, Uanataca…) firma
# digitalmente cada PDF de informe: Adobe enseña quién firmó, cuándo y si el
# documento fue alterado. El archivo va DENTRO del volumen de subidas —p. ej.
# `docker cp firma.p12 accumedical-api-1:/srv/uploads/firma/accumedical.p12`—
# y la contraseña SOLO en tu .env. Vacío = los PDF salen sin firmar.
FIRMA_P12_PATH=
FIRMA_P12_PASSWORD=
